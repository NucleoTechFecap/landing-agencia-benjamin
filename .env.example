# ════════════════════════════════════════════════════════════════════════════════
#  Agência Benjamin Landing Page — variáveis de ambiente (ARC-05)
#
#  Copie para `.env.local` (desenvolvimento) e preencha. NUNCA commite valores reais.
#  Homologação e produção: cadastre os valores na Vercel, por ambiente
#  (Preview / Production). Detalhes: docs/ambientes/variaveis-de-ambiente.md
# ════════════════════════════════════════════════════════════════════════════════

# ── Públicas (embutidas no bundle do navegador no build — nada sigiloso aqui) ──────

# Origem canônica usada em canonical, Open Graph, sitemap e llms.txt.
# Obrigatória em homologação e produção. Ex.: https://www.agenciabenjamin.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | preview | homologation | production
# Fora de "production" o site envia noindex e bloqueia robôs.
NEXT_PUBLIC_SITE_ENV=development

# Projeto Supabase do ambiente (Settings → API). Sem estes valores o site usa o
# conteúdo provisório de content/ e o painel fica indisponível.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Servidor (somente Server Components, Server Actions, Route Handlers e scripts) ─

# Chave service_role: ignora RLS. Usada apenas no servidor para gravar envios de
# formulário já validados e por scripts operacionais (INT-08). Nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo (mín. 32 caracteres) para HMAC de IP e impressão digital de envios
# de formulário (TECH-07). Gere com: openssl rand -base64 48
SUBMISSION_HASH_SECRET=

# Notificações de formulários: "log" (apenas registra, padrão em dev) ou "resend".
NOTIFY_PROVIDER=log
RESEND_API_KEY=
NOTIFICATION_FROM="Agência Benjamin <nao-responda@exemplo.com.br>"

# Destinatários por tipo de envio (lista separada por vírgula). Definidos pela
# Agência Benjamin (CON-10). Não usar e-mails pessoais fixos no código (TECH-06).
LEAD_NOTIFICATION_TO=
CONTACT_NOTIFICATION_TO=
FEEDBACK_NOTIFICATION_TO=

# debug | info | warn | error
LOG_LEVEL=info

# Segredo (mín. 32 caracteres) do POST /api/internal/revalidate, usado por webhook do
# banco ou operação manual para invalidar o cache público (TECH-09).
CONTENT_REVALIDATE_SECRET=
