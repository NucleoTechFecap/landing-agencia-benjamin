{
  "name": "agencia-benjamin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:supabase": "node scripts/test-supabase.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:restore": "node scripts/test-restore.mjs",
    "perf:queries": "node scripts/explain-queries.mjs",
    "seed:write": "node --experimental-strip-types --no-warnings scripts/content-seed.mjs --write",
    "seed:check": "node --experimental-strip-types --no-warnings scripts/content-seed.mjs --check",
    "carga:write": "node --experimental-strip-types --no-warnings scripts/content-seed.mjs --carga --write",
    "seed:users": "node scripts/seed-users.mjs",
    "check:headers": "node scripts/file-headers.mjs --check",
    "headers:write": "node scripts/file-headers.mjs --write",
    "verify": "npm run check:headers && npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "check:release-content": "RELEASE_GATE=1 vitest run content",
    "test:e2e": "playwright test",
    "test:e2e:cms": "node scripts/e2e-cms.mjs",
    "release:check": "npm run verify && npm run check:release-content"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^25.9.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Plataforma institucional da Agência Benjamin (FECAP) desenvolvida pelo NúcleoTech.",
  "engines": {
    "node": ">=20.9.0"
  }
}
