{
  "name": "agencia-benjamin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:supabase": "node scripts/test-supabase.mjs",
    "check:headers": "node scripts/file-headers.mjs --check",
    "headers:write": "node scripts/file-headers.mjs --write",
    "verify": "npm run check:headers && npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "check:release-content": "RELEASE_GATE=1 vitest run content",
    "test:e2e": "playwright test",
    "release:check": "npm run verify && npm run check:release-content"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "description": "Plataforma institucional da Agência Benjamin (FECAP) desenvolvida pelo NúcleoTech.",
  "engines": {
    "node": ">=20.9.0"
  }
}
