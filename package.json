{
  "name": "agencia-benjamin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:headers": "node scripts/file-headers.mjs --check",
    "headers:write": "node scripts/file-headers.mjs --write",
    "verify": "npm run check:headers && npm run typecheck && npm run lint && npm run test && npm run build",
    "check:release-content": "RELEASE_GATE=1 vitest run content"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "description": "Plataforma institucional da Agência Benjamin (FECAP) desenvolvida pelo NúcleoTech.",
  "engines": {
    "node": ">=20.9.0"
  }
}
